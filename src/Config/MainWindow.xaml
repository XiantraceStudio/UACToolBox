<ui:FluentWindow x:Class="UACToolBox.Config.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="UACToolBox" Width="1180" Height="820" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F5F5" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:TitleBar Title="UACToolBox"/>
 <Grid Grid.Row="1" Margin="0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="3" Width="204" HorizontalAlignment="Left" Background="#EEEEEE"/>
  <TabControl x:Name="Pages" Grid.Row="1" SelectionChanged="PageChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SideItem}">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#EEEEEE" CornerRadius="0" Padding="12,20,12,14"><DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28"><Border Background="#444444" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Apps24" Foreground="White" FontSize="24"/></Border><TextBlock Text="UACToolBox" FontSize="21" FontWeight="SemiBold" Margin="0,14,0,4"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="10,24,0,0"></StackPanel>
     <StackPanel IsItemsHost="True"/>
    </DockPanel></Border>
    <ContentPresenter Grid.Column="2" ContentSource="SelectedContent" Margin="0,8,24,12"/>
   </Grid></ControlTemplate></TabControl.Template>
   <TabItem x:Name="ListPage" ><TabItem.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Apps24" Margin="0,0,12,0"/><TextBlock Text="程序列表"/></StackPanel></TabItem.Header>
    <Grid Margin="0,16,0,0">

     <DockPanel>
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="我的快捷方式" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel><ui:Button Style="{StaticResource ActionButton}" Content="新建快捷方式" Appearance="Primary" Click="NewClick"/><ui:Button Style="{StaticResource ActionButton}" Content="导入 EXE / 快捷方式" Click="ImportClick"/></WrapPanel><ui:TextBox Style="{StaticResource FormInput}" x:Name="SearchBox" PlaceholderText="搜索快捷方式名称或程序路径" TextChanged="SearchChanged" ToolTip="按名称或路径搜索" AutomationProperties.Name="搜索程序"/></StackPanel>
      <ListBox x:Name="EntriesList" MouseDoubleClick="OpenClick" PreviewMouseRightButtonDown="SelectContextItem" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
<ListBox.ContextMenu><ContextMenu Opened="ListMenuOpened"><MenuItem Header="打开" Click="OpenClick"/><MenuItem Header="编辑" Click="EditClick"/><Separator/><MenuItem Header="删除" Click="DeleteClick"/></ContextMenu></ListBox.ContextMenu>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Border Padding="18" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="10" Background="#EEEEEE" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Apps24" Foreground="#444444"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding ShortcutName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePath}" Foreground="#777777" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,7,12,0"/></StackPanel>
        <Border Grid.Column="2" Background="#EFF7F2" CornerRadius="10" Padding="10,5" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="已启用"/><Setter Property="Foreground" Value="#25805D"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Text" Value="已停用"/><Setter Property="Foreground" Value="#777777"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
       </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Grid>
   </TabItem>
   <TabItem x:Name="EditorPage" ><TabItem.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Margin="0,0,12,0"/><TextBlock Text="创建 / 编辑"/></StackPanel></TabItem.Header>
     <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20"><ui:Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="导入程序 / 快捷方式" Click="ImportClick" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="EditorTitle" Text="创建快捷方式" FontSize="28" FontWeight="SemiBold"/></StackPanel></DockPanel>
      <TabControl x:Name="EditorTabs" Grid.Row="1"><TabItem Header="程序与启动"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">      <TextBlock Text="快捷方式名称（无需填写 .lnk）"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="NameInput" PlaceholderText="例如：我的程序_UACTB"/>
      <TextBlock Text="目标程序"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="PathInput" TextChanged="TargetPathChanged"/>
      <TextBlock Text="启动参数（保留原始引号）"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="ArgumentsInput" PlaceholderText="可选，保留原始参数和引号"/>
      <TextBlock Text="工作目录"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="DirectoryInput"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="输出位置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="快捷方式创建位置"/>
      <ComboBox x:Name="DestinationInput" SelectedIndex="0" SelectionChanged="DestinationChanged" AutomationProperties.Name="快捷方式创建位置"><ComboBoxItem Content="桌面"/><ComboBoxItem Content="自定义文件夹…"/></ComboBox>
      <DockPanel x:Name="CustomDestinationPanel" Visibility="Collapsed">
       <ui:Button Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Content="选择文件夹…" Click="ChooseDestinationClick" VerticalAlignment="Top"/>
       <ui:TextBox Style="{StaticResource FormInput}" x:Name="DestinationPathInput" IsReadOnly="True" AutomationProperties.Name="自定义快捷方式文件夹"/>
      </DockPanel>
</StackPanel></ScrollViewer></TabItem><TabItem Header="更多设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">      <TextBlock Text="窗口状态"/><ComboBox x:Name="ShowInput" SelectedIndex="0"><ComboBoxItem Content="正常"/><ComboBoxItem Content="最小化"/><ComboBoxItem Content="最大化"/></ComboBox>
      <TextBlock Text="图标路径"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="IconInput"/>
      <TextBlock Text="图标索引"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="IconIndexInput" Text="0"/>
      <CheckBox x:Name="EnabledInput" Content="启用此项" ToolTip="停用后保留配置，已有快捷方式将无法启动此程序。" IsChecked="True" Margin="0,0,0,8"/>
</StackPanel></ScrollViewer></TabItem></TabControl>
      <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0"><DockPanel>
       
       <WrapPanel HorizontalAlignment="Right"><ui:Button Style="{StaticResource ActionButton}" Content="返回列表" Click="BackClick"/><ui:Button Style="{StaticResource ActionButton}" Content="仅保存" Click="SaveClick"/><ui:Button Style="{StaticResource ActionButton}" Content="保存并创建" Appearance="Primary" Click="ShortcutClick"/></WrapPanel>
      </DockPanel></Border>
     </Grid>
   </TabItem>
   <TabItem x:Name="SettingsPage"><TabItem.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0"/><TextBlock Text="设置"/></StackPanel></TabItem.Header><TabControl x:Name="SettingsTabs">
    <TabItem Header="系统"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
     <DockPanel Margin="0,0,0,20">
      <ui:Button x:Name="RegisterButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0" Content="一键注册" Appearance="Primary" Click="RegisterClick" VerticalAlignment="Center" ToolTip="全部组件就绪后无需注册。"/>
      <ui:Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0,0,12,0" Content="刷新状态" Click="RefreshClick" VerticalAlignment="Center"/>
      <TextBlock Text="系统组件" FontSize="28" FontWeight="SemiBold"/>
     </DockPanel>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="后台执行任务" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="首次安装需一次管理员授权；保存配置与启动程序都通过它执行。" Foreground="#777777" FontSize="12" Margin="0,4,0,8"/>
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="InstallDot" Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Top" Margin="1,5,9,0"/><TextBlock x:Name="InstallStatus" TextWrapping="Wrap" Foreground="#555555"/></StackPanel>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
       <ui:Button Style="{StaticResource ActionButton}" Content="安装 / 修复" Appearance="Primary" Click="InstallClick"/>
       <ui:Button Style="{StaticResource ActionButton}" Content="卸载" Click="UninstallClick"/>
      </WrapPanel>
     </Grid></Border>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="启动器环境变量" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="%XianTrace_UAC_ToolBox% 指向启动器路径，快捷方式通过它启动。" Foreground="#777777" FontSize="12" Margin="0,4,0,8"/>
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="EnvironmentDot" Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Top" Margin="1,5,9,0"/><TextBlock x:Name="EnvironmentStatus" TextWrapping="Wrap" Foreground="#555555"/></StackPanel>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
       <ui:Button Style="{StaticResource ActionButton}" Content="更新" Appearance="Primary" Click="EnvironmentClick"/>
       <ui:Button Style="{StaticResource ActionButton}" Content="移除" Click="RemoveEnvironmentClick"/>
      </WrapPanel>
     </Grid></Border>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="资源管理器右键菜单" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="提供「通过 UACToolBox 运行」和「添加到 UACToolBox…」两项。" Foreground="#777777" FontSize="12" Margin="0,4,0,8"/>
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="MenusDot" Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Top" Margin="1,5,9,0"/><TextBlock x:Name="MenusStatus" TextWrapping="Wrap" Foreground="#555555"/></StackPanel>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
       <ui:Button Style="{StaticResource ActionButton}" Content="添加 / 修复" Appearance="Primary" Click="MenusClick"/>
       <ui:Button Style="{StaticResource ActionButton}" Content="移除" Click="RemoveMenusClick"/>
      </WrapPanel>
     </Grid></Border>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><StackPanel>
      <TextBlock Text="配置文件" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="保存全部快捷方式条目，由后台任务写入，日常修改无需管理员权限。" Foreground="#777777" FontSize="12" Margin="0,4,0,8"/>
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConfigurationDot" Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Top" Margin="1,5,9,0"/><TextBlock x:Name="ConfigurationStatus" TextWrapping="Wrap" Foreground="#555555"/></StackPanel>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="关于"><StackPanel Margin="24"><TextBlock Text="UACToolBox" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="WPF UI · .NET 10" Margin="0,16,0,0"/><TextBlock Text="配置管理与快捷启动工具" Margin="0,12,0,0"/></StackPanel></TabItem></TabControl></TabItem>
   <TabItem ><TabItem.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Document24" Margin="0,0,12,0"/><TextBlock Text="操作记录"/></StackPanel></TabItem.Header><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="本次操作记录" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/><ui:TextBox Style="{StaticResource FormInput}" Grid.Row="1" x:Name="Diagnostics" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="就绪" Foreground="#666666" Margin="228,8,24,12" TextWrapping="Wrap"/>
 </Grid>
 </Grid>
</ui:FluentWindow>
