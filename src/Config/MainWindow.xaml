<ui:FluentWindow x:Class="UACToolBox.Config.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:loc="clr-namespace:UACToolBox.Config" Title="UACToolBox" Width="1180" Height="820" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F5F5" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:TitleBar Title="UACToolBox"/>
 <Grid Grid.Row="1" Margin="0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="3" Width="204" HorizontalAlignment="Left" Background="#EEEEEE"/>
  <TabControl x:Name="Pages" Grid.Row="1" SelectionChanged="PageChanged" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SideItem}">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#EEEEEE" CornerRadius="0" Padding="12,20,12,14"><DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28"><Border Background="#444444" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Apps24" Foreground="White" FontSize="24"/></Border><TextBlock Text="UACToolBox" FontSize="21" FontWeight="SemiBold" Margin="0,14,0,4"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="10,24,0,0"></StackPanel>
     <StackPanel IsItemsHost="True"/>
    </DockPanel></Border>
    <ContentPresenter Grid.Column="2" ContentSource="SelectedContent" Margin="0,8,24,12"/>
   </Grid></ControlTemplate></TabControl.Template>
   <TabItem x:Name="ListPage" ><TabItem.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Apps24" Margin="0,0,12,0"/><TextBlock Text="{loc:Loc nav.list}"/></StackPanel></TabItem.Header>
    <Grid Margin="0,16,0,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="{loc:Loc list.title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel><ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc list.new}" Appearance="Primary" Click="NewClick"/><ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc list.import}" Click="ImportClick"/></WrapPanel><ui:TextBox Style="{StaticResource FormInput}" x:Name="SearchBox" PlaceholderText="{loc:Loc list.search}" TextChanged="SearchChanged" ToolTip="{loc:Loc list.search.tip}" AutomationProperties.Name="{loc:Loc list.search}"/></StackPanel>
      <ListBox x:Name="EntriesList" MouseDoubleClick="OpenClick" PreviewMouseRightButtonDown="SelectContextItem" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
<ListBox.ContextMenu><ContextMenu Opened="ListMenuOpened"><MenuItem Header="{loc:Loc menu.open}" Click="OpenClick"/><MenuItem Header="{loc:Loc menu.edit}" Click="EditClick"/><Separator/><MenuItem Header="{loc:Loc menu.delete}" Click="DeleteClick"/></ContextMenu></ListBox.ContextMenu>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Border Padding="18" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="10" Background="#EEEEEE" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Apps24" Foreground="#444444"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding ShortcutName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePath}" Foreground="#777777" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,7,12,0"/></StackPanel>
        <Border Grid.Column="2" Background="#EFF7F2" CornerRadius="10" Padding="10,5" VerticalAlignment="Center"><TextBlock HorizontalAlignment="Center" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Loc list.enabled}"/><Setter Property="Foreground" Value="#25805D"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Text" Value="{loc:Loc list.disabled}"/><Setter Property="Foreground" Value="#777777"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
       </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </Grid>
   </TabItem>
   <TabItem x:Name="EditorPage" ><TabItem.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Add24" Margin="0,0,12,0"/><TextBlock Text="{loc:Loc nav.editor}"/></StackPanel></TabItem.Header>
     <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,20"><ui:Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="{loc:Loc editor.import}" Click="ImportClick" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="EditorTitle" Text="{loc:Loc editor.create.title}" FontSize="28" FontWeight="SemiBold"/></StackPanel></DockPanel>
      <TabControl x:Name="EditorTabs" Grid.Row="1"><TabItem Header="{loc:Loc editor.tab.launch}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
      <TextBlock Text="{loc:Loc editor.name}"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="NameInput" PlaceholderText="{loc:Loc editor.name.ph}"/>
      <TextBlock Text="{loc:Loc editor.path}"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="PathInput" TextChanged="TargetPathChanged"/>
      <TextBlock Text="{loc:Loc editor.args}"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="ArgumentsInput" PlaceholderText="{loc:Loc editor.args.ph}"/>
      <TextBlock Text="{loc:Loc editor.dir}"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="DirectoryInput"/>
</StackPanel></ScrollViewer></TabItem><TabItem Header="{loc:Loc editor.tab.output}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="{loc:Loc editor.dest}"/>
      <ComboBox x:Name="DestinationInput" SelectedIndex="0" SelectionChanged="DestinationChanged" AutomationProperties.Name="{loc:Loc editor.dest}"><ComboBoxItem Content="{loc:Loc editor.dest.desktop}"/><ComboBoxItem Content="{loc:Loc editor.dest.custom}"/></ComboBox>
      <DockPanel x:Name="CustomDestinationPanel" Visibility="Collapsed">
       <ui:Button Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Content="{loc:Loc editor.dest.pick}" Click="ChooseDestinationClick" VerticalAlignment="Top"/>
       <ui:TextBox Style="{StaticResource FormInput}" x:Name="DestinationPathInput" IsReadOnly="True" AutomationProperties.Name="{loc:Loc editor.dest.custom}"/>
      </DockPanel>
</StackPanel></ScrollViewer></TabItem><TabItem Header="{loc:Loc editor.tab.more}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
      <TextBlock Text="{loc:Loc editor.show}"/><ComboBox x:Name="ShowInput" SelectedIndex="0"><ComboBoxItem Content="{loc:Loc show.normal}"/><ComboBoxItem Content="{loc:Loc show.min}"/><ComboBoxItem Content="{loc:Loc show.max}"/></ComboBox>
      <TextBlock Text="{loc:Loc editor.icon}"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="IconInput"/>
      <TextBlock Text="{loc:Loc editor.iconIndex}"/><ui:TextBox Style="{StaticResource FormInput}" x:Name="IconIndexInput" Text="0"/>
      <CheckBox x:Name="EnabledInput" Content="{loc:Loc editor.enabled}" ToolTip="{loc:Loc editor.enabled.tip}" IsChecked="True" Margin="0,0,0,8"/>
</StackPanel></ScrollViewer></TabItem></TabControl>
      <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0"><DockPanel>
       <WrapPanel HorizontalAlignment="Right"><ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc editor.back}" Click="BackClick"/><ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc editor.save}" Click="SaveClick"/><ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc editor.saveCreate}" Appearance="Primary" Click="ShortcutClick"/></WrapPanel>
      </DockPanel></Border>
     </Grid>
   </TabItem>
   <TabItem x:Name="SettingsPage"><TabItem.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0"/><TextBlock Text="{loc:Loc nav.settings}"/></StackPanel></TabItem.Header><TabControl x:Name="SettingsTabs">
    <TabItem Header="{loc:Loc settings.tab.system}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
     <DockPanel Margin="0,0,0,20">
      <ui:Button x:Name="RegisterButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0" Content="{loc:Loc settings.register}" Appearance="Primary" Click="RegisterClick" VerticalAlignment="Center" ToolTip="{loc:Loc settings.register.tip}"/>
      <ui:Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Margin="0,0,12,0" Content="{loc:Loc settings.refresh}" Click="RefreshClick" VerticalAlignment="Center"/>
      <TextBlock Text="{loc:Loc settings.system}" FontSize="28" FontWeight="SemiBold"/>
     </DockPanel>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{loc:Loc card.task.title}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{loc:Loc card.task.desc}" Foreground="#777777" FontSize="12" Margin="0,4,0,8"/>
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="InstallDot" Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Top" Margin="1,5,9,0"/><TextBlock x:Name="InstallStatus" TextWrapping="Wrap" Foreground="#555555"/></StackPanel>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
       <ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc card.task.install}" Appearance="Primary" Click="InstallClick"/>
       <ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc card.task.uninstall}" Click="UninstallClick"/>
      </WrapPanel>
     </Grid></Border>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{loc:Loc card.env.title}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{loc:Loc card.env.desc}" Foreground="#777777" FontSize="12" Margin="0,4,0,8"/>
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="EnvironmentDot" Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Top" Margin="1,5,9,0"/><TextBlock x:Name="EnvironmentStatus" TextWrapping="Wrap" Foreground="#555555"/></StackPanel>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
       <ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc card.env.update}" Appearance="Primary" Click="EnvironmentClick"/>
       <ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc card.env.remove}" Click="RemoveEnvironmentClick"/>
      </WrapPanel>
     </Grid></Border>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{loc:Loc card.menu.title}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{loc:Loc card.menu.desc}" Foreground="#777777" FontSize="12" Margin="0,4,0,8"/>
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="MenusDot" Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Top" Margin="1,5,9,0"/><TextBlock x:Name="MenusStatus" TextWrapping="Wrap" Foreground="#555555"/></StackPanel>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
       <ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc card.menu.add}" Appearance="Primary" Click="MenusClick"/>
       <ui:Button Style="{StaticResource ActionButton}" Content="{loc:Loc card.menu.remove}" Click="RemoveMenusClick"/>
      </WrapPanel>
     </Grid></Border>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><StackPanel>
      <TextBlock Text="{loc:Loc card.file.title}" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Loc card.file.desc}" Foreground="#777777" FontSize="12" Margin="0,4,0,8"/>
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConfigurationDot" Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Top" Margin="1,5,9,0"/><TextBlock x:Name="ConfigurationStatus" TextWrapping="Wrap" Foreground="#555555"/></StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource FormCard}" Padding="22,18"><StackPanel>
      <TextBlock Text="{loc:Loc settings.language}" FontSize="16" FontWeight="SemiBold"/>
      <ComboBox x:Name="LanguageBox" SelectedIndex="0" SelectionChanged="LanguageChanged" Margin="0,8,0,8" MinWidth="240" HorizontalAlignment="Left"/>
      <TextBlock Text="{loc:Loc settings.language.hint}" Foreground="#777777" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="{loc:Loc settings.tab.about}"><StackPanel Margin="24"><TextBlock Text="{loc:Loc about.name}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc about.stack}" Margin="0,16,0,0"/><TextBlock Text="{loc:Loc about.desc}" Margin="0,12,0,0"/></StackPanel></TabItem></TabControl></TabItem>
   <TabItem ><TabItem.Header><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Document24" Margin="0,0,12,0"/><TextBlock Text="{loc:Loc nav.log}"/></StackPanel></TabItem.Header><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{loc:Loc log.title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/><ui:TextBox Style="{StaticResource FormInput}" Grid.Row="1" x:Name="Diagnostics" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="StatusText" Text="{loc:Loc msg.ready}" Foreground="#666666" Margin="228,8,24,12" TextWrapping="Wrap"/>
 </Grid>
 </Grid>
</ui:FluentWindow>
