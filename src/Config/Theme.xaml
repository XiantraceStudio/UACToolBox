<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
   <ResourceDictionary.MergedDictionaries><ui:ThemesDictionary Theme="Light"/><ui:ControlsDictionary/></ResourceDictionary.MergedDictionaries>
<!-- WPF UI 的强调色 Color 键在库内合并字典里；在此顶层定义可被 DynamicResource 链优先命中，避免默认蓝色。 -->
<Color x:Key="SystemAccentColor">#444444</Color>
<Color x:Key="SystemAccentColorPrimary">#444444</Color>
<Color x:Key="SystemAccentColorSecondary">#444444</Color>
<Color x:Key="SystemAccentColorTertiary">#4A4A4A</Color>
<Color x:Key="AccentFillColorDefault">#444444</Color>
<Color x:Key="AccentFillColorSecondary">#4A4A4A</Color>
<Color x:Key="AccentFillColorTertiary">#525252</Color>
<SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#444444"/>
<SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#555555"/>
<SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#666666"/>
<SolidColorBrush x:Key="AccentButtonBackground" Color="#444444"/>
<SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#4C4C4C"/>
<SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#3A3A3A"/>
<SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#333333"/>
<SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#444444"/>
<SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#444444"/>
<SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#555555"/>
<SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#666666"/>
   <Style x:Key="FormInput" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}"><Setter Property="Margin" Value="0,7,0,16"/><Setter Property="MinHeight" Value="40"/></Style>
   <Style x:Key="ActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="16,9"/></Style>
   <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,7,0,16"/><Setter Property="MinHeight" Value="40"/></Style>
   <Style x:Key="SideItem" TargetType="TabItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,3"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="Tile" CornerRadius="0" Padding="16,13" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#E5E5E5"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="#DDDDDD"/><Setter Property="Foreground" Value="#222222"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#444444"/><Setter TargetName="Tile" Property="BorderThickness" Value="1"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="FormCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDDDDD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22,20,22,6"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
   <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  </ResourceDictionary>
